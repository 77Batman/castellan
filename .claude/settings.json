{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableAutoMode": "disable",
    "additionalDirectories": ["../castellan-worktrees"],
    "allow": [
      "Read", "Edit", "Write", "Task", "Glob", "Grep",
      "Bash(cd:*)", "Bash(git:*)", "Bash(python:*)", "Bash(python3:*)",
      "Bash(pip:*)", "Bash(pip3:*)", "Bash(pytest:*)", "Bash(sqlite3:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(mkdir:*)", "Bash(mv:*)", "Bash(cp:*)",
      "Bash(grep:*)", "Bash(tail:*)", "Bash(head:*)", "Bash(wc:*)",
      "Bash(find:*)", "Bash(echo:*)", "Bash(sed:*)", "Bash(awk:*)",
      "Bash(diff:*)", "Bash(sort:*)", "Bash(uniq:*)", "Bash(touch:*)",
      "Bash(source:*)", "Bash(which:*)", "Bash(date:*)", "Bash(sleep:*)",
      "WebFetch", "WebSearch"
    ],
    "deny": [
      "Bash(sudo:*)", "Bash(rm -rf:*)", "Bash(crontab:*)",
      "Bash(launchctl:*)", "Bash(ssh:*)", "Bash(scp:*)", "Bash(rsync:*)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Write(./book/vaults/**)", "Edit(./book/vaults/**)",
      "Write(./book/registry.db)", "Edit(./book/registry.db)"
    ]
  }
}
